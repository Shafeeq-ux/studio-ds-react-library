{
  "name": "studio-ds",
  "version": "0.1.0",
  "description": "Studio DS — React + TypeScript design system component library",
  "type": "module",
  "main": "./dist/studio-ds.js",
  "module": "./dist/studio-ds.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/studio-ds.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/studio-ds.js"
  ],
  "scripts": {
    "dev": "storybook dev -p 44041 --no-open",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "lint": "oxlint src",
    "storybook": "storybook dev -p 44041 --no-open",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.5.2",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^8.6.14",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-static-copy": "^2.3.2"
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "studio-ds",
    "storybook"
  ],
  "license": "MIT"
}
